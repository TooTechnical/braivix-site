# BrAIvix website contact and "Run Offline Test" email notifications.
# Hostinger Email (hPanel → Emails → Manage → Connect Apps & Devices).
# SMTP host smtp.hostinger.com, implicit SSL/TLS, port 465.
# Authenticate using ONE existing Hostinger mailbox. The "From" address is
# exactly this mailbox; both founders are always recipients.
# NEVER commit .env.local or post the mailbox password in a chat.
HOSTINGER_SMTP_USER=d.malone@braivix.com
HOSTINGER_SMTP_PASS=

# Optional server-side CRM/backend forwarding after SMTP accepts the mail.
# Leave blank unless the endpoint is configured as storage-only.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
