# Required for both /contact and "Run Offline Test" notifications.
# Create a Resend account, verify the braivix.com sending domain, and
# create a server-side API key. Never expose this as NEXT_PUBLIC_*.
RESEND_API_KEY=
LEAD_FROM_EMAIL=BrAIvix <leads@braivix.com>

# Optional: send a copy to a CRM/backend AFTER the notification email is accepted.
# The backend should store the lead but not send duplicate notifications.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
